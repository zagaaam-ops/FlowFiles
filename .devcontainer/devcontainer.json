{
  "name": "FlowFiles Flutter Development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "postCreateCommand": "bash .devcontainer/install_flutter.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code"
      ]
    }
  },

  "remoteEnv": {
    "CC": "/usr/bin/gcc",
    "CXX": "/usr/bin/g++"
  }
}
